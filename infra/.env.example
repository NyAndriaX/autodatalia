# OpenRouter API configuration
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-your-key-here
AI_MODEL=google/gemini-2.0-flash-lite-001
# Cheap/fast model for quick actions (shorten/expand/tone). Falls back to
# AI_MODEL if unset. Part of the LLM Router cost strategy.
AI_MODEL_FAST=google/gemini-2.0-flash-lite-001
# OFF by default — sending image bytes to a vision model is the costliest
# input. Opt in per-request or flip this to true.
AI_INCLUDE_IMAGES=false
# Hard ceiling of real (non-cached) AI calls per client per day. 0 = off.
AI_DAILY_LIMIT=200

# Comma-separated origins allowed to call the backend directly (CORS).
# Defaults to the local Next.js dev server if unset.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
