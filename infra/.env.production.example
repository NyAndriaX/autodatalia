# Copy to `.env.production` on the host.
# Used by `docker compose -f docker-compose.prod.yml --env-file .env.production ...`
#
# The `start-prod.ps1` helper can generate the local file and secrets for you.

# Host + domain
# API_DOMAIN and FRONTEND_DOMAIN MUST share the same registrable domain
# (datalia.app) so the SameSite=Lax session cookie set by /auth/login is
# sent on cross-subdomain requests between the frontend and the API.
# CORS_ALLOW_ORIGINS must EXACTLY equal https://<FRONTEND_DOMAIN> (add the
# https://www.<domain> variant only if you serve the apex/www host).
API_DOMAIN=api.datalia.app
FRONTEND_DOMAIN=app.datalia.app
CORS_ALLOW_ORIGINS=https://app.datalia.app

# Auth
# Optional shared token for server-to-server callers. Browser users rely on
# the HttpOnly session cookie set by /auth/login.
# Leave these EMPTY in the example: the backend's production guard refuses to
# boot on an empty/placeholder JWT_SECRET, so deploy fails loudly instead of
# running with a known-bad secret. Generate real values on the host with
# `openssl rand -hex 32` — see DEPLOY.md.
BACKEND_AUTH_TOKEN=
JWT_SECRET=
ALLOW_OPEN_AUTH=false
# Brute-force throttle on /auth/login (backend defaults shown).
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# MariaDB
DATABASE_URL=
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=datalia
MARIADB_USER=datalia
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# AI text
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=google/gemini-2.5-flash
AI_MODEL_FAST=google/gemini-2.5-flash
AI_MODEL_PREMIUM=google/gemini-2.5-pro
AI_INCLUDE_IMAGES=true
AI_DAILY_LIMIT=200

# Meta
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_DOMAIN_VERIFY=
TIKTOK_SCOPES=user.info.basic,video.upload
TIKTOK_UPLOAD_MODE=file

# LinkedIn / Google sign-in
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202603
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram validation
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# AI image/video
AI_IMAGE_API_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=
AI_VIDEO_API_BASE_URL=
AI_VIDEO_API_KEY=
AI_VIDEO_MODEL=
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=lightricks/ltx-video
REPLICATE_VIDEO_VERSION=
FAL_API_KEY=
FAL_VIDEO_MODEL=fal-ai/ltx-video
LTX_API_KEY=
LTX_API_BASE_URL=https://api.ltx.video/v1
LTX_VIDEO_MODEL=ltx-2-3-pro
VIDEO_COST_PER_SECOND_USD=0.04

# Scheduler
DATALIA_DEFAULT_TZ=Europe/Paris
