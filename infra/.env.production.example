# Copy to `.env.production` on the host and fill in real values.
# Used by `docker compose -f docker-compose.prod.yml --env-file .env.production ...`
#
# NEVER commit the real `.env.production` to git. The .example file
# (this one) is safe to commit because it has no secrets.
#
# Generation snippets for the three required secrets:
#   BACKEND_AUTH_TOKEN=$(openssl rand -hex 32)
#   JWT_SECRET=$(openssl rand -hex 32)
#   TELEGRAM_WEBHOOK_SECRET=$(openssl rand -hex 32)

# ── Host + domain ──────────────────────────────────────────────────────
# The bare hostname Caddy serves on. NOT a URL — no scheme, no path.
# Once DNS A record points here, Caddy provisions a Let's Encrypt cert
# on first hit. Used by OAUTH_REDIRECT_BASE + PUBLIC_BASE_URL in the
# compose file so callbacks + media URLs both land on this domain.
API_DOMAIN=api.datalia.com

# Dashboard hostname served by the frontend container through Caddy.
# Use a different hostname from API_DOMAIN, e.g. datalia.com or app.datalia.com.
FRONTEND_DOMAIN=datalia.com

# Origins allowed to hit the API. Production frontend goes here; add
# the Vercel project URL too if you want preview deploys to hit prod.
# Comma-separated, no trailing slash.
CORS_ALLOW_ORIGINS=https://datalia.com

# Locks /generate, /transform, /upload, mutating /posts behind a Bearer
# header. STRONGLY recommended ON in prod — without it anyone with the
# API hostname can drain your OpenRouter wallet by hammering /generate.
# Generate with: `openssl rand -hex 32`
BACKEND_AUTH_TOKEN=

# JWT signing secret for user session tokens. Must be random and unique
# to this deployment. Generate with: openssl rand -hex 32
JWT_SECRET=

# ── Postgres (users / auth) ──────────────────────────────────────────
# The compose file spins up a postgres:16-alpine container next to the
# API. For tiny deploys those defaults are fine; for any real workload
# point DATABASE_URL at a managed Postgres (Hetzner, Neon, Railway,
# Supabase, RDS, …) and leave POSTGRES_* on their compose defaults.
# Generate the password with: openssl rand -hex 24
DATABASE_URL=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=datalia
POSTGRES_USER=datalia
POSTGRES_PASSWORD=

# ── AI (OpenRouter) ───────────────────────────────────────────────────
# Used by the caption-generation and content-transform endpoints. Get a
# key at https://openrouter.ai/keys. The 3-tier model routing lets the
# fast model handle quick actions and saves cost on most generations.
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=google/gemini-2.0-flash-lite-001
AI_MODEL_FAST=google/gemini-2.0-flash-lite-001
AI_MODEL_PREMIUM=
AI_INCLUDE_IMAGES=true
AI_DAILY_LIMIT=200

# ── Meta (Facebook Page + Instagram Business) ──────────────────────────
# developers.facebook.com → your app → Settings → Basic. Use the prod
# app once it's unblocked for Facebook Pages; until then the dev app's
# ID works for end-to-end testing.
META_APP_ID=
META_APP_SECRET=
# The IG-Login pair is for the modern Instagram Login flow, currently
# blocked behind Meta Business Portfolio verification. Leave empty —
# IG goes through Meta scopes instead.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── TikTok ────────────────────────────────────────────────────────────
# developers.tiktok.com → your app → App details.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Token shown in TikTok dev portal after you complete the "Verify URL
# prefix" step. The backend serves the matching tiktok<token>.txt file
# at the API root automatically.
TIKTOK_DOMAIN_VERIFY=
# Comma-separated. Sandbox-safe default below. Once the app is audited,
# switch to: user.info.basic,video.upload,video.publish — that unlocks
# direct posting without the inbox draft step.
TIKTOK_SCOPES=user.info.basic,video.upload
# "file" = FILE_UPLOAD (byte-PUT to TikTok's CDN — no URL-Properties
# prefix verification required). "pull" = PULL_FROM_URL (faster, but
# requires the API host prefix to be verified at TikTok). Leave "file"
# unless you've completed that verification step.
TIKTOK_UPLOAD_MODE=file

# ── LinkedIn (optional, when you have an app) ─────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202603

# ── Google (team sign-in only — NOT for posting) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Telegram validation bot (required for Automation module) ──────────
# Without these the Automation tab still creates posts, but they sit in
# `awaiting_validation` forever — the validation gate has no transport.
#
# Setup (one-time):
#   1. On Telegram, message @BotFather → /newbot → get TELEGRAM_BOT_TOKEN
#   2. Message @userinfobot to get YOUR chat ID (positive number) for
#      TELEGRAM_DEFAULT_CHAT_ID, or use a group's negative ID.
#   3. Generate TELEGRAM_WEBHOOK_SECRET with `openssl rand -hex 32`.
#   4. After first boot, register the webhook once:
#        curl "https://api.telegram.org/bot<TOKEN>/setWebhook?\
#            url=https://api.datalia.com/telegram/webhook&\
#            secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── AI image generation (optional, recommended) ──────────────────────
# Datalia's automation module generates one fresh image per carousel
# slide. Without these the fallback (Pillow placeholder) runs — fine
# for dev, ugly in production. Two API shapes are supported:
#
#   (a) Chat-completions — auto-detected when the model id contains
#       'gemini' AND 'image'. Used for Google's Nano Banana.
#         AI_IMAGE_API_BASE_URL=https://openrouter.ai/api/v1
#         AI_IMAGE_API_KEY=<OpenRouter key>
#         AI_IMAGE_MODEL=google/gemini-2.5-flash-image
#       For Nano Banana 2 (better quality, slightly pricier):
#         AI_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
#       or for Google AI Studio direct:
#         AI_IMAGE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#         AI_IMAGE_API_KEY=<from https://aistudio.google.com/app/apikey>
#         AI_IMAGE_MODEL=gemini-2.5-flash-image
#
#   (b) Classic /images/generations — DALL·E, FLUX, fal.ai, etc.
#         Together AI:  base=https://api.together.xyz/v1
#                       model=black-forest-labs/FLUX.1-schnell-Free
#                       key from https://api.together.xyz
#         OpenAI:       base=https://api.openai.com/v1
#                       model=dall-e-3
#                       key from https://platform.openai.com/api-keys
#         fal.ai:       base=https://api.fal.ai/openai
#                       model=fal-ai/flux/schnell
#                       key from https://fal.ai/dashboard/keys
AI_IMAGE_API_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=

# ── AI video generation (LTX-2) ──────────────────────────────────────
# Provider auto-pick: LTX-2 → fal.ai → ffmpeg Ken Burns fallback. When
# the configured external provider raises at runtime (insufficient
# credit, overload, 5xx), the backend automatically retries the SAME
# job on the ffmpeg fallback so the user always gets a video — see the
# `attempts` array on each VideoJob.
#
# ★ LTX-2 official API (recommended — 100 free credits, no card)
#   Sign up at https://console.ltx.video, generate a key, paste below.
#   Same authors as the LTX-Video model. Synchronous endpoint returns
#   MP4 bytes directly.
LTX_API_KEY=
LTX_API_BASE_URL=https://api.ltx.video/v1
# Valid models per docs.ltx.video: ltx-2-3-pro (quality) /
# ltx-2-3-fast (speed). "ltx-2" alone is not valid.
LTX_VIDEO_MODEL=ltx-2-3-pro

# fal.ai (also free signup, but credit policy varies)
#   https://fal.ai/dashboard/keys
FAL_API_KEY=
FAL_VIDEO_MODEL=fal-ai/ltx-video

# Replicate (pay-as-you-go, requires a version hash for community models)
#   1. Token at https://replicate.com/account/api-tokens
#   2. Copy the latest version hash from
#      https://replicate.com/lightricks/ltx-video/versions
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=lightricks/ltx-video
REPLICATE_VIDEO_VERSION=

# Per-second cost used by the cost dashboard. LTX-2 / fal.ai / Replicate
# all bill ~$0.04/s; override if you switch to a different model.
VIDEO_COST_PER_SECOND_USD=0.04

# Legacy passthrough for the synchronous video-API path. Safe to leave blank.
AI_VIDEO_API_BASE_URL=
AI_VIDEO_API_KEY=
AI_VIDEO_MODEL=

# ── Scheduler ──────────────────────────────────────────────────────────
# IANA timezone. Posts without an explicit timezone fire in this one.
# Automation rules default to this too. Pick whatever the team mostly
# schedules in.
DATALIA_DEFAULT_TZ=Europe/Paris
