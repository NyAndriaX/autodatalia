# Copy this file to .env.local and fill in the values you need.
# Restart `next dev` after any change.
# All vars use the NEXT_PUBLIC_ prefix (client-side readable).

# Backend base URL.
# The FastAPI backend natively handles CORS, so the frontend communicates
# directly with it (bypassing Next.js rewrites entirely).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
