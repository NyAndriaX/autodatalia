# Copy this file to .env.local and fill in the values you need.
# Restart `next dev` after any change.
# All vars use the NEXT_PUBLIC_ prefix (client-side readable).

# Backend base URL.
# Empty → AI falls back to local mock; no HTTP calls to the backend.
# Set to /api/backend to use the built-in same-origin rewrite proxy → localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# n8n webhook URLs — leave blank to skip POSTing; buttons still update status locally.
NEXT_PUBLIC_N8N_SAVE_DRAFT_URL=
NEXT_PUBLIC_N8N_SUBMIT_VALIDATION_URL=
NEXT_PUBLIC_N8N_PUBLISH_URL=
NEXT_PUBLIC_N8N_SCHEDULE_URL=
