# ══════════════════════════════════════════════════════════════
#  DATALIA — Configuration backend (exemple)
#  Copiez ce fichier en ".env" et remplissez les valeurs.
#  Ce fichier peut être commité — il ne contient aucune clé réelle.
# ══════════════════════════════════════════════════════════════

# ── Base de données ────────────────────────────────────────────
DATABASE_URL=mysql://utilisateur:motdepasse@127.0.0.1:3306/datalia

# ── Stockage des médias uploadés ──────────────────────────────
# Dev local  → chemin absolu vers backend/content sur votre machine
#              ex: /home/user/projet/backend/content
# Prod Docker → /app/content  (valeur par défaut si cette variable est absente)
#              → laisser cette variable vide ou commentée en production Docker
CONTENT_DIR=/home/user/projet/backend/content

# ── CORS — origines autorisées ────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Authentification ──────────────────────────────────────────
# Token Bearer optionnel pour les appels serveur-à-serveur.
# Laissez vide pour désactiver la vérification en dev.
BACKEND_AUTH_TOKEN=changez-ce-token

# Inscription et connexion ouvertes (pratique en dev local)
ALLOW_OPEN_AUTH=true
ALLOW_OPEN_REGISTRATION=false

# Secret JWT — générer avec : openssl rand -hex 32
JWT_SECRET=

# ── URLs publiques ────────────────────────────────────────────
# URL de base pour les callbacks OAuth et les URLs de médias.
# En local : http://localhost:8000
# Avec ngrok : https://<votre-domaine>.ngrok-free.dev
OAUTH_REDIRECT_BASE=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# ── Intelligence Artificielle (OpenRouter) ────────────────────
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-votre-cle-openrouter
AI_MODEL=google/gemini-2.5-flash
AI_MODEL_FAST=google/gemini-2.5-flash
AI_MODEL_PREMIUM=google/gemini-2.5-pro
AI_INCLUDE_IMAGES=false
AI_DAILY_LIMIT=200

# ── Génération d'images ───────────────────────────────────────
AI_IMAGE_API_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=

# ── Génération de vidéos ──────────────────────────────────────
AI_VIDEO_API_BASE_URL=
AI_VIDEO_API_KEY=
AI_VIDEO_MODEL=

# Replicate (LTX-Video)
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=lightricks/ltx-video
REPLICATE_VIDEO_VERSION=

# fal.ai
FAL_API_KEY=
FAL_VIDEO_MODEL=fal-ai/ltx-video

# LTX officiel (Lightricks)
LTX_API_KEY=
LTX_API_BASE_URL=https://api.ltx.video/v1
LTX_VIDEO_MODEL=ltx-2-3-pro
VIDEO_COST_PER_SECOND_USD=0.04

# ── Réseaux sociaux — OAuth direct ────────────────────────────
META_APP_ID=
META_APP_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_DOMAIN_VERIFY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202603

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Zernio (API sociale unifiée, optionnel) ───────────────────
ZERNIO_API_KEY=
ZERNIO_API_BASE_URL=https://zernio.com/api/v1

# ── Telegram (bot de validation, optionnel) ───────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── Tunnel Cloudflare (optionnel, désactivé par défaut) ───────
TUNNEL_ENABLED=false
