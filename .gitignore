# ========================================
# DATALIA — Root .gitignore
# ========================================

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# ---------- Tool configs (local) ----------
.claude/
.sixth/
.gemini/

# ---------- Node / Frontend ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
frontend/.next/
frontend/out/
frontend/build/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files (keep examples)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/

# ---------- Python / Backend ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.Python
pip-log.txt
pip-delete-this-directory.txt

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Misc ----------
*.pem
*.log
.cache/
tmp/
