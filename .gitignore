# ========================================
# DATALIA — Root .gitignore
# ========================================

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
.Spotlight-V100
.Trashes

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath
.history/

# ---------- Tool configs (local) ----------
.claude/
.sixth/
.gemini/

# ---------- Node / Frontend ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Env files ----------
# Règle générale : tous les .env sauf les .env.example
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.staging
.env.production
.env.production.local
# Sous-dossiers explicites
backend/.env
backend/.env.*
infra/.env
infra/.env.*
frontend/.env
frontend/.env.*
# Toujours commiter les fichiers d'exemple
!**/.env.example
!.env.example

# ---------- Vercel ----------
.vercel

# ---------- TypeScript ----------
*.tsbuildinfo
next-env.d.ts

# ---------- Tests & couverture ----------
coverage/
.nyc_output/
htmlcov/
.pytest_cache/
.coverage
.coverage.*

# ---------- Python / Backend ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.Python
pip-log.txt
pip-delete-this-directory.txt
# SQLite / bases locales de dev
*.sqlite
*.sqlite3
*.db

# Celery
celerybeat-schedule
celerybeat.pid

# ---------- Secrets & certificats ----------
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der

# ---------- Backend runtime content ----------
# Garder le dossier, ignorer les uploads, captions générés et le cache AI
# (le cache peut contenir des prompts/réponses — ne jamais commiter).
backend/content/*
!backend/content/.gitkeep

# OAuth tokens — déjà couverts par backend/content/* mais listés
# explicitement pour que ce soit évident.
backend/content/.oauth_tokens*.json

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Logs ----------
*.log
logs/
/logs.txt
/logs-*.txt

# ---------- Misc ----------
.cache/
tmp/
.temp/

# Test images / fixtures one-shot déposés à la racine de backend/ lors du
# débogage de la conversion d'images. Les vraies fixtures vivent sous backend/tests/.
backend/test.png
backend/test.jpg
backend/test.jpeg
backend/test_*.png
backend/test_*.jpg
backend/test_*.jpeg
